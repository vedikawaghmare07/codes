#include <iostream>
#include <string>
using namespace std;

struct Node
{
    string data;
    Node* next;
};

Node* head = NULL;

// Insert at front
void insertFront(string text)
{
    Node* newNode = new Node;
    newNode->data = text;
    newNode->next = head;
    head = newNode;
}

// Insert at end
void insertEnd(string text)
{
    Node* newNode = new Node;
    newNode->data = text;
    newNode->next = NULL;

    if(head == NULL)
    {
        head = newNode;
        return;
    }

    Node* temp = head;
    while(temp->next != NULL)
    {
        temp = temp->next;
    }

    temp->next = newNode;
}

// Insert at any position
void insertPosition(string text, int pos)
{
    if(pos == 1)
    {
        insertFront(text);
        return;
    }

    Node* temp = head;

    for(int i = 1; i < pos - 1 && temp != NULL; i++)
    {
        temp = temp->next;
    }

    if(temp == NULL)
    {
        cout << "Invalid Position!";
        return;
    }

    Node* newNode = new Node;
    newNode->data = text;
    newNode->next = temp->next;
    temp->next = newNode;
}

// Delete from front
void deleteFront()
{
    if(head == NULL)
    {
        cout << "List is Empty!";
        return;
    }

    Node* temp = head;
    head = head->next;
    delete temp;
}

// Delete from end
void deleteEnd()
{
    if(head == NULL)
    {
        cout << "List is Empty!";
        return;
    }

    if(head->next == NULL)
    {
        delete head;
        head = NULL;
        return;
    }

    Node* temp = head;

    while(temp->next->next != NULL)
    {
        temp = temp->next;
    }

    delete temp->next;
    temp->next = NULL;
}

// Delete from any position
void deletePosition(int pos)
{
    if(head == NULL)
    {
        cout << "List is Empty!";
        return;
    }

    if(pos == 1)
    {
        deleteFront();
        return;
    }

    Node* temp = head;

    for(int i = 1; i < pos - 1 && temp != NULL; i++)
    {
        temp = temp->next;
    }

    if(temp == NULL || temp->next == NULL)
    {
        cout << "Invalid Position!";
        return;
    }

    Node* del = temp->next;
    temp->next = del->next;
    delete del;
}

// Display list
void display()
{
    Node* temp = head;

    if(head == NULL)
    {
        cout << "List is Empty!";
        return;
    }

    cout << "\nText Lines:\n";

    while(temp != NULL)
    {
        cout << temp->data << endl;
        temp = temp->next;
    }
}

// Display in reverse order
void reverseDisplay(Node* temp)
{
    if(temp == NULL)
        return;

    reverseDisplay(temp->next);
    cout << temp->data << endl;
}

// Reverse linked list
void reverseList()
{
    Node *prev = NULL, *current = head, *next = NULL;

    while(current != NULL)
    {
        next = current->next;
        current->next = prev;
        prev = current;
        current = next;
    }

    head = prev;
}

int main()
{
    int choice, pos;
    string text;

    do
    {
        cout << "\n\n--- TEXT EDITOR ---";
        cout << "\n1. Insert at Front";
        cout << "\n2. Insert at End";
        cout << "\n3. Insert at Position";
        cout << "\n4. Delete from Front";
        cout << "\n5. Delete from End";
        cout << "\n6. Delete from Position";
        cout << "\n7. Display Text";
        cout << "\n8. Display in Reverse";
        cout << "\n9. Reverse Linked List";
        cout << "\n10. Exit";

        cout << "\nEnter your choice: ";
        cin >> choice;

        switch(choice)
        {
            case 1:
                cout << "Enter text: ";
                cin.ignore();
                getline(cin, text);
                insertFront(text);
                break;

            case 2:
                cout << "Enter text: ";
                cin.ignore();
                getline(cin, text);
                insertEnd(text);
                break;

            case 3:
                cout << "Enter position: ";
                cin >> pos;
                cout << "Enter text: ";
                cin.ignore();
                getline(cin, text);
                insertPosition(text, pos);
                break;

            case 4:
                deleteFront();
                break;

            case 5:
                deleteEnd();
                break;

            case 6:
                cout << "Enter position: ";
                cin >> pos;
                deletePosition(pos);
                break;

            case 7:
                display();
                break;

            case 8:
                cout << "\nReverse Text:\n";
                reverseDisplay(head);
                break;

            case 9:
                reverseList();
                cout << "Linked List Reversed!";
                break;

            case 10:
                cout << "Exiting...";
                break;

            default:
                cout << "Invalid Choice!";
        }

    } while(choice != 10);

    return 0;
}
