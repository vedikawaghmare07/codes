
#include <iostream>
using namespace std;

#define SIZE 5

// Stack implementation
int stackArr[SIZE];
int top = -1;

// Queue implementation
int queueArr[SIZE];
int front = -1, rear = -1;

// Push operation
void push(int parcel)
{
    if (top == SIZE - 1)
    {
        cout << "Stack Overflow!\n";
    }
    else
    {
        top++;
        stackArr[top] = parcel;
        cout << "Parcel " << parcel << " added to stack.\n";
    }
}

// Pop operation
void pop()
{
    if (top == -1)
    {
        cout << "Stack Underflow!\n";
    }
    else
    {
        cout << "Parcel " << stackArr[top] << " removed from stack.\n";
        top--;
    }
}

// Display stack
void displayStack()
{
    if (top == -1)
    {
        cout << "Stack is empty.\n";
    }
    else
    {
        cout << "Stack parcels: ";
        for (int i = top; i >= 0; i--)
        {
            cout << stackArr[i] << " ";
        }
        cout << endl;
    }
}

// Enqueue operation
void enqueue(int parcel)
{
    if (rear == SIZE - 1)
    {
        cout << "Queue Overflow!\n";
    }
    else
    {
        if (front == -1)
            front = 0;

        rear++;
        queueArr[rear] = parcel;
        cout << "Parcel " << parcel << " added to queue.\n";
    }
}

// Dequeue operation
void dequeue()
{
    if (front == -1 || front > rear)
    {
        cout << "Queue Underflow!\n";
    }
    else
    {
        cout << "Parcel " << queueArr[front] << " dispatched.\n";
        front++;

        if (front > rear)
        {
            front = rear = -1;
        }
    }
}

// Display queue
void displayQueue()
{
    if (front == -1)
    {
        cout << "Queue is empty.\n";
    }
    else
    {
        cout << "Queue parcels: ";
        for (int i = front; i <= rear; i++)
        {
            cout << queueArr[i] << " ";
        }
        cout << endl;
    }
}

int main()
{
    int choice, parcel;

    do
    {
        cout << "\n--- POST OFFICE PARCEL SYSTEM ---\n";
        cout << "1. Add Parcel to Stack\n";
        cout << "2. Remove Parcel from Stack\n";
        cout << "3. Display Stack\n";
        cout << "4. Add Parcel to Queue\n";
        cout << "5. Dispatch Parcel from Queue\n";
        cout << "6. Display Queue\n";
        cout << "7. Exit\n";

        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice)
        {
            case 1:
                cout << "Enter parcel ID: ";
                cin >> parcel;
                push(parcel);
                break;

            case 2:
                pop();
                break;

            case 3:
                displayStack();
                break;

            case 4:
                cout << "Enter parcel ID: ";
                cin >> parcel;
                enqueue(parcel);
                break;

            case 5:
                dequeue();
                break;

            case 6:
                displayQueue();
                break;

            case 7:
                cout << "Exiting Post Office System.\n";
                break;

            default:
                cout << "Invalid choice!\n";
        }

    } while (choice != 7);

    return 0;
}
