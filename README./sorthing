
#include <iostream>
using namespace std;

int main()
{
    int n, a[50], b[50], c[50], d[50];

    cout << "Enter number of products: ";
    cin >> n;

    cout << "Enter product prices:\n";
    for (int i = 0; i < n; i++)
    {
        cin >> a[i];
        b[i] = a[i];
        c[i] = a[i];
        d[i] = a[i];
    }

    // Bubble Sort
    for (int i = 0; i < n - 1; i++)
    {
        for (int j = 0; j < n - i - 1; j++)
        {
            if (b[j] > b[j + 1])
            {
                int temp = b[j];
                b[j] = b[j + 1];
                b[j + 1] = temp;
            }
        }
    }

    // Selection Sort
    for (int i = 0; i < n - 1; i++)
    {
        int min = i;

        for (int j = i + 1; j < n; j++)
        {
            if (c[j] < c[min])
                min = j;
        }

        int temp = c[i];
        c[i] = c[min];
        c[min] = temp;
    }

    // Insertion Sort
    for (int i = 1; i < n; i++)
    {
        int key = d[i];
        int j = i - 1;

        while (j >= 0 && d[j] > key)
        {
            d[j + 1] = d[j];
            j--;
        }

        d[j + 1] = key;
    }

    cout << "\nPrices after Bubble Sort: ";
    for (int i = 0; i < n; i++)
        cout << b[i] << " ";

    cout << "\nPrices after Selection Sort: ";
    for (int i = 0; i < n; i++)
        cout << c[i] << " ";

    cout << "\nPrices after Insertion Sort: ";
    for (int i = 0; i < n; i++)
        cout << d[i] << " ";

    return 0;
}
